# Sanal ortam (her bilgisayarda yeniden oluşturulur)
.venv/

# Python'un derlenmiş ara dosyaları (C'deki .o dosyalarına benzer)
__pycache__/
*.py[cod]

# Test ve araç önbellekleri
.pytest_cache/

# Eğitilmiş modeller: sadece her deneyin en iyisi git'e girer ("last" dosyaları girmez)
models/*.pth
!models/best.pth
!models/best_*.pth

# Eğitim sırasında üretilen geçici grafikler
plots/

# Kişisel çalışma günlüğü (sadece yerelde tutulur)
calisma_gunlugu.md

# Editör ve işletim sistemi dosyaları
.vscode/
.idea/
Thumbs.db
.DS_Store
